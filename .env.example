# ==============================================================================
# DIHADIR — Sistem Presensi Digital Pertemuan SMKN 1 Majalengka
# Contoh Konfigurasi Lingkungan (Clean Template)
# ==============================================================================

APP_NAME="DIHADIR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://dihadir.smkn1majalengka.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ------------------------------------------------------------------------------
# Keamanan & Autentikasi
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Basis Data & Penyimpanan
# Pilihan DB_CONNECTION:
#   1. 'sqlite' (Default cepat & mandiri, tersimpan di database/database.sqlite)
#   2. 'mysql'  (Untuk XAMPP / phpMyAdmin / Laragon / Server MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Konfigurasi MySQL / phpMyAdmin (Aktifkan saat DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dihadir
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Sesi & Keamanan Cookie
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Antrean & Cache (Database Backed)
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# Kredensial Resmi Super Admin (Inisialisasi Pertama)
# ------------------------------------------------------------------------------
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_EMAIL="admin@smkn1majalengka.sch.id"
SUPERADMIN_PASSWORD="GantiPasswordKuat2026!"
